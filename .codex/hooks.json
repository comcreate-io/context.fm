{
  "description": "context.fm repo-local hooks. Build the binary first: go build -o bin/contextfm-hook ./cmd/hook",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/contextfm-hook\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
